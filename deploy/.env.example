# ────────────────────────────────────────────────────────
# BCN Civic Vision — Deploy Environment Variables
# Copy this to .env and fill in your API keys
# ────────────────────────────────────────────────────────

# ── LLM Provider (Groq — free) ──────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=600

# Alternative: OpenAI (paid)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o-mini

# Alternative: Together AI (free trial)
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=your-together-key
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Alternative: Remote Ollama (your own machine)
# LLM_BASE_URL=http://your-host:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=gemma3:4b

# ── Embedding Provider (Jina AI — free) ─────────────────
# Must match the model used during re-embedding!
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_API_KEY=your-jina-key-here
EMBEDDING_MODEL=jina-embeddings-v3

# ── Retrieval Budget Controls ───────────────────────────
CHROMA_N_RESULTS=8
FINAL_CONTEXT_CHUNKS=3

# ── Feature Toggles ─────────────────────────────────────
ENABLE_PAGEINDEX=false

# ── CORS ────────────────────────────────────────────────
FRONTEND_URL=

# ── Server (Render sets PORT automatically) ─────────────
# PORT=8001
