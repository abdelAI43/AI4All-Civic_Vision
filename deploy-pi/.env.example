# Copy to deploy-pi/.env on the Pi and fill in. NEVER commit the real .env.
# Used both for the frontend build (VITE_*) and the api container (server-side).

# ---- Frontend (baked into the bundle at build time; public values) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_MAPBOX_TOKEN=pk.your-mapbox-token
# Leave empty so the frontend calls same-origin /api (nginx proxies it).
VITE_API_URL=

# ---- API container (server-side secrets; NOT exposed to the browser) ----
GOOGLE_GEMINI_API_KEY=your-gemini-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# RAG stays on Render:
RAG_BACKEND_URL=https://ai4all-civic-vision.onrender.com
# APP_URL is set to http://web by docker-compose; no need to change it here.
